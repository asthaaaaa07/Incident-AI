# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

PORT=3000

# PostgreSQL connection string.
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/incident_ai

NODE_ENV=development

# Optional but recommended: the secret you configure in your GitHub webhook
# settings. If set, the server verifies the X-Hub-Signature-256 header on
# every webhook request and rejects anything that doesn't match. If left
# blank, webhooks are accepted WITHOUT verification (fine for early local
# testing, not fine for anything exposed to the internet via ngrok long-term).
WEBHOOK_SECRET=
